#: src/Admin/Editor/TermFields.php:60 src/Admin/Editor/TermFields.php:107
msgid "Optional absolute HTTP(S) URL"
msgstr "URL HTTP(S) absoluta opcional"

#: src/Admin/Editor/TermFields.php:61 src/Admin/Editor/TermFields.php:108
msgid ""
