#: src/Admin/Editor/TermFields.php:86 src/Admin/SettingsPage.php:564
msgid "Meta description"
msgstr "Metadescripción"

#: src/Admin/Editor/SeoMetaBox.php:85
msgid ""
"Leave empty to use the global template. Core Blueprint emits no fallback "
"description when neither an override nor a template is configured."
msgstr ""
"Déjalo vacío para usar la plantilla global. Core Blueprint no publica una "
"descripción alternativa cuando no hay ni una personalización ni una "
"plantilla configurada."

#: src/Admin/Editor/SeoMetaBox.php:89
msgid "Resolved preview"
msgstr "Vista previa resuelta"

#: src/Admin/Editor/SeoMetaBox.php:90
msgid "WordPress default title"
msgstr "Título predeterminado de WordPress"

#: src/Admin/Editor/SeoMetaBox.php:91
msgid "No Core Blueprint meta description"
msgstr "Sin metadescripción de Core Blueprint"

#: src/Admin/Editor/SeoMetaBox.php:111 src/Admin/Editor/TermFields.php:49
#: src/Admin/Editor/TermFields.php:93
msgid "Search engine directives"
msgstr "Directivas para motores de búsqueda"

#: src/Admin/Editor/SeoMetaBox.php:112
msgid ""
"These are restrictive per-content overrides. Leave them unchecked to keep "
"the normal WordPress or global SEO policy."
msgstr ""
"Son restricciones específicas para este contenido. Déjalas desmarcadas para "
"mantener la política normal de WordPress o la política SEO global."

#: src/Admin/Editor/SeoMetaBox.php:113
msgid "Block this content from search engine indexes (noindex)"
msgstr ""
"Bloquear la indexación de este contenido por los motores de búsqueda "
"(noindex)"

#: src/Admin/Editor/SeoMetaBox.php:114
msgid "Do not ask search engines to follow links on this content (nofollow)"
msgstr ""
"Pedir a los motores de búsqueda que no sigan los enlaces de este contenido "
"(nofollow)"

#: src/Admin/Editor/SeoMetaBox.php:115
msgid "Do not index images from this content (noimageindex)"
msgstr "No indexar las imágenes de este contenido (noimageindex)"

#: src/Admin/Editor/SeoMetaBox.php:116
msgid "Do not provide a cached copy of this content (noarchive)"
msgstr "No proporcionar una copia en caché de este contenido (noarchive)"

#: src/Admin/Editor/SeoMetaBox.php:117
msgid "Do not show a text snippet for this content (nosnippet)"
msgstr "No mostrar un fragmento de texto para este contenido (nosnippet)"

#: src/Admin/Editor/SeoMetaBox.php:118
msgid ""
"Content marked noindex is also excluded from the WordPress XML sitemap while "
"Core Blueprint SEO is active."
msgstr ""
"El contenido marcado como noindex también se excluye del sitemap XML de "
"WordPress mientras Core Blueprint SEO esté activo."

#: src/Admin/Editor/SeoMetaBox.php:122 src/Admin/Editor/TermFields.php:59
#: src/Admin/Editor/TermFields.php:105 src/Admin/SettingsPage.php:565
msgid "Canonical URL"
msgstr "URL canónica"

#: src/Admin/Editor/SeoMetaBox.php:123
msgid "Use the normal WordPress canonical"
msgstr "Usar la URL canónica normal de WordPress"

#: src/Admin/Editor/SeoMetaBox.php:124
msgid ""
"Optional absolute HTTP(S) URL. Leave empty to keep the normal WordPress/site "
"canonical behaviour."
msgstr ""
"URL HTTP(S) absoluta opcional. Déjalo vacío para mantener el comportamiento "
"canónico normal de WordPress/del sitio."

#: src/Admin/Editor/SeoMetaBox.php:134
msgid ""
"Optional Open Graph and X/Twitter overrides. Empty fields inherit the "
"resolved SEO metadata."
msgstr ""
"Anulaciones opcionales de Open Graph y X/Twitter. Los campos vacíos heredan "
"los metadatos SEO resueltos."

