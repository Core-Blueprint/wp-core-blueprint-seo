#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

fail() {
  printf 'SEO checks failed: %s\n' "$*" >&2
  exit 1
}

for command in php python3 git wp msgfmt node; do
  command -v "$command" >/dev/null 2>&1 || fail "missing required command: $command"
done

PHP_VERSION="$(php -r 'echo PHP_VERSION;')"
php -r 'exit(version_compare(PHP_VERSION, "8.4", ">=") ? 0 : 1);' || {
  printf 'ERROR: PHP 8.4+ is required for SEO checks (found %s).\n' "$PHP_VERSION" >&2
  exit 1
}

while IFS= read -r -d '' file; do
  php -l "$file" >/dev/null || fail "PHP lint failed: $file"
done < <(find . \
  -path './.git' -prune -o \
  -path './dist' -prune -o \
  -path './build' -prune -o \
  -path './vendor' -prune -o \
  -path './.venv' -prune -o \
  -type f -name '*.php' -print0)

echo "PHP syntax: PASS"

while IFS= read -r -d '' file; do
  node --check "$file" >/dev/null || fail "JavaScript syntax failed: $file"
done < <(find assets -type f -name '*.js' -print0)

bash -n "$ROOT/tools/runtime-test" || fail "runtime test harness shell syntax failed"

"$ROOT/tools/i18n/check"

for test in "$ROOT"/tests/*-regression.php; do
  [[ -f "$test" ]] || fail "no SEO product regressions found"
  php "$test"
done

echo "Core Blueprint SEO checks: PASS"
